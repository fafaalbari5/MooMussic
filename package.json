{
  "name": "moomussic",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "better-sqlite3": "^12.11.1",
    "discord-rpc": "^4.0.1",
    "ffmpeg-static": "^5.3.0",
    "play-dl": "^1.9.7",
    "yt-dlp-wrap": "^2.3.12",
    "yt-search": "^2.13.1"
  },
  "build": {
    "appId": "com.moomussic.app",
    "productName": "MooMussic",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ]
  }
}